{
  "name": "@wb04307201/pretty-log",
  "description": "A frontend toolkit for beautifying console log output. It helps developers display log information in a cleaner, more readable format in the browser console.",
  "private": false,
  "version": "1.1.0",
  "source": "src/index.ts",
  "main": "dist/main.js",
  "module": "dist/module.js",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.js",
      "require": "./dist/main.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "parcel build",
    "test": "parcel test/test.html",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts test/*.test.js",
    "test:unit:offline": "node --experimental-strip-types --test test/core.test.ts test/features.test.ts test/effects.test.ts test/ci.test.js test/workflow-contract.test.js",
    "verify:tag": "node scripts/verify-tag-version.js",
    "prepublishOnly": "node --test test/*.test.ts test/*.test.js && npx tsc --noEmit"
  },
  "keywords": [],
  "devDependencies": {
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "parcel": "^2.16.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "author": "wb04307201",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wb04307201/pretty-log"
  },
  "bugs": {
    "url": "https://github.com/wb04307201/pretty-log/issues"
  },
  "homepage": "https://github.com/wb04307201"
}
